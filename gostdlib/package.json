  "scripts": {
    "unicode:generate": "cd .. && go run ./internal/contracts/gostdlib/unicodegenerate -output gostdlib/src/internal/portable/unicode/classification-data.generated.ts",
    "unicode:check": "cd .. && go run ./internal/contracts/gostdlib/unicodegenerate -output gostdlib/src/internal/portable/unicode/classification-data.generated.ts -check",
    "contract:generate": "cd .. && go run ./internal/contracts/gostdlib/generate -repository . -provider gostdlib -manifest gostdlib/contract/manifest.json -modules gostdlib/contract/modules.json -facets gostdlib/contract/facets.json -runtime gostdlib/contract/runtime.json -tsconfig gostdlib/tsconfig.json -scratch .temp/gostdlib-certify -goos linux -goarch amd64 -tags noasm -backend node -minimum-go go1.26.4 -maximum-go go1.26.4",
    "contract:check": "cd .. && go run ./internal/contracts/gostdlib/generate -repository . -provider gostdlib -manifest gostdlib/contract/manifest.json -modules gostdlib/contract/modules.json -facets gostdlib/contract/facets.json -runtime gostdlib/contract/runtime.json -tsconfig gostdlib/tsconfig.json -scratch .temp/gostdlib-certify -goos linux -goarch amd64 -tags noasm -backend node -minimum-go go1.26.4 -maximum-go go1.26.4 -check",
    "runtime:generate": "cd .. && go run ./internal/emit/runtime/generate -contract gostdlib/contract/runtime.json -module . -output gostdlib/test/runtime-package -profile number -assembly provider-certification",
    "runtime:check": "cd .. && go run ./internal/emit/runtime/generate -contract gostdlib/contract/runtime.json -module . -output gostdlib/test/runtime-package -profile number -assembly provider-certification -check",
    "runtime:build": "go tool tsgo -p test/runtime-package/tsconfig.json",
    "build:provider": "go tool tsgo -p tsconfig.json",
    "build": "npm run clean && npm run unicode:check && npm run contract:check && npm run runtime:check && npm run runtime:build && npm run build:provider",
    "check": "npm run build && node scripts/check-public-surface.mjs && node --test \"dist/test/**/*.test.js\"",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "@gotots/runtime": "0.0.0"
  },
  "devDependencies": {
    "@gotots/runtime": "file:test/runtime-package",
    "@types/node": "25.9.1"
  }
}
