{
  "name": "@gotots/gostdlib",
  "version": "0.0.0",
  "description": "Go standard-library behavior for GoToTS",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/src",
    "contract/manifest.json",
    "README.md"
  ],
  "exports": {
    "./*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "go tool tsgo -p tsconfig.json",
    "check": "npm run build && node scripts/check-public-surface.mjs && node --test \"dist/test/**/*.test.js\"",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "@gotots/runtime": "0.0.0"
  },
  "devDependencies": {
    "@gotots/runtime": "file:test/runtime-package",
    "@types/node": "25.9.1"
  }
}
