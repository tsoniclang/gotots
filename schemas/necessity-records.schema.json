{
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "additionalProperties": false,
        "properties": {
          "mechanism": { "type": "string", "pattern": "nonempty" },
          "kind": {
            "type": "string",
            "enum": ["representation-carrier", "indirection-cell", "dispatch", "boundary-adapter"]
          },
          "proofTier": {
            "type": "string",
            "enum": ["observable-behavior", "aliasing-identity", "dynamic-type"]
          },
          "semanticClass": { "type": "string", "pattern": "nonempty" },
          "specClause": { "type": "string", "pattern": "nonempty" },
          "siteClasses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "nonempty" }
          },
          "counterexample": { "type": "string", "pattern": "nonempty" },
          "ordinaryTypescript": { "type": "string", "pattern": "nonempty" },
          "ordinaryMismatch": { "type": "string", "pattern": "nonempty" },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "additionalProperties": false,
              "properties": {
                "candidate": { "type": "string", "pattern": "nonempty" },
                "rejected": { "type": "string", "pattern": "nonempty" }
              },
              "required": ["candidate", "rejected"]
            }
          },
          "smallestMechanism": { "type": "string", "pattern": "nonempty" },
          "oracleTests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "nonempty" }
          },
          "mutationTests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "nonempty" }
          },
          "performanceEvidence": { "type": "string", "pattern": "nonempty" },
          "invalidation": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "nonempty" }
          },
          "acceptance": { "type": "string", "pattern": "nonempty" },
          "reopening": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "nonempty" }
          }
        },
        "required": [
          "mechanism", "kind", "proofTier", "semanticClass", "specClause",
          "siteClasses", "counterexample", "ordinaryTypescript", "ordinaryMismatch",
          "alternatives", "smallestMechanism", "oracleTests", "mutationTests",
          "performanceEvidence", "invalidation", "acceptance", "reopening"
        ]
      }
    }
  },
  "required": ["schemaVersion", "records"]
}
